    <path
        android:pathData="M102,48 H108 A4,4 0 0 1 112,52 V68 A4,4 0 0 1 108,72 H102 A3,3 0 0 1 99,69 V51 A3,3 0 0 1 102,48 Z"
        android:fillColor="#EC4899" />

