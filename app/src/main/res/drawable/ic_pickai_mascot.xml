                android:startX="20"
                android:startY="32"
                android:endX="100"
                android:endY="88"
                android:type="linear">
                <item android:color="#7C3AED" android:offset="0.0" />
                <item android:color="#4F46E5" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Headphones Band -->
    <path
        android:pathData="M16,56 C14,24 106,24 104,56"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:strokeColor="#C084FC" />

    <!-- Left Ear Cup -->
