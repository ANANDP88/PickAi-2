<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="120dp"
    android:height="120dp"
    android:viewportWidth="120"
    android:viewportHeight="120">

    <!-- Glowing Background Aura -->
    <path
        android:pathData="M60,60m-52,0a52,52 0,1 1,104 0a52,52 0,1 1,-104 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="60"
                android:centerY="55"
                android:gradientRadius="55"
                android:type="radial">
                <item android:color="#338B5CF6" android:offset="0.0" />
                <item android:color="#006366F1" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Mascot Antenna with Sparkle -->
    <path
        android:pathData="M60,32 L60,18"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:strokeColor="#A855F7" />

    <!-- Antenna Glowing Spark / Diamond -->
    <path
        android:pathData="M60,10 L64,16 L60,22 L56,16 Z"
        android:fillColor="#FACC15" />
    <path
        android:pathData="M54,16 L66,16"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeColor="#FEF08A" />

    <!-- Mascot Head Base (Rounded Robot Monitor / Capsule) -->
    <path
        android:pathData="M34,32 H86 A18,18 0 0 1 104,50 V66 A22,22 0 0 1 82,88 H38 A22,22 0 0 1 16,66 V50 A18,18 0 0 1 34,32 Z">
