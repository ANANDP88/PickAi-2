    <path
        android:pathData="M40,54 A6,9 0 1 0 52,54 A6,9 0 1 0 40,54 Z"
        android:fillColor="#06B6D4" />
    <path
        android:pathData="M48,51 A2,3 0 1 0 52,51 A2,3 0 1 0 48,51 Z"
        android:fillColor="#FFFFFF" />

    <!-- Right Glowing Eye (Oval Cyan) -->
    <path
        android:pathData="M68,54 A6,9 0 1 0 80,54 A6,9 0 1 0 68,54 Z"
        android:fillColor="#06B6D4" />
    <path
        android:pathData="M76,51 A2,3 0 1 0 80,51 A2,3 0 1 0 76,51 Z"
        android:fillColor="#FFFFFF" />

