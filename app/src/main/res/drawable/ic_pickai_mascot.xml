    <path
        android:pathData="M32,63 A3,2 0 1 0 38,63 A3,2 0 1 0 32,63 Z"
        android:fillColor="#F472B6" />
    <path
        android:pathData="M82,63 A3,2 0 1 0 88,63 A3,2 0 1 0 82,63 Z"
        android:fillColor="#F472B6" />

    <!-- Decorative AI Sparkles on side -->
    <path
        android:pathData="M98,28 L100,24 L102,28 L106,30 L102,32 L100,36 L98,32 L94,30 Z"
        android:fillColor="#FBBF24" />
    <path
        android:pathData="M18,32 L19,30 L20,32 L22,33 L20,34 L19,36 L18,34 L16,33 Z"
